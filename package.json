{
  "name": "mojibake-fixer",
  "productName": "乱码文件名修复台",
  "version": "1.0.0",
  "private": true,
  "description": "乱码文件名修复台 — 解压文件或老文档变成天书乱码？拖进来自动识别并一键还原成正常中文",
  "author": "Over9rowth",
  "license": "GPL-3.0-only",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "manual": "npm run build && electron scripts/make-manual-pdf.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.10.2",
    "@electron-forge/maker-squirrel": "7.10.2",
    "@electron-forge/maker-zip": "7.10.2",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "electron": "44.9.3",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": false,
        "name": "MojibakeFixer",
        "executableName": "MojibakeFixer",
        "appBundleId": "local.instruments.mojibakefixer",
        "appCopyright": "Copyright (C) 2026 Over9rowth (GPL-3.0)",
        "appVersion": "0.1.0",
        "icon": "resources/icon.ico",
        "win32metadata": {
          "CompanyName": "Over9rowth",
          "FileDescription": "乱码文件名修复台",
          "ProductName": "乱码文件名修复台",
          "LegalCopyright": "Copyright (C) 2026 Over9rowth (GPL-3.0)",
          "InternalName": "MojibakeFixer",
          "OriginalFilename": "MojibakeFixer.exe"
        },
        "ignore": [
          "^/tests",
          "^/docs",
          "^/src",
          "^/scripts",
          "^/resources",
          "^/node_modules",
          "^/out",
          "^/out-",
          "^/project_meta",
          "^/SPEC\\.md$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "MojibakeFixer",
            "title": "乱码文件名修复台",
            "setupIcon": "resources/icon.ico"
          }
        }
      ]
    }
  },
  "keywords": [
    "electron",
    "typescript",
    "react",
    "desktop-app",
    "windows-app",
    "offline-first",
    "gplv3",
    "mojibake",
    "character-encoding",
    "utf8",
    "gb18030",
    "shift-jis",
    "text-recovery",
    "shannon-entropy"
  ]
}
